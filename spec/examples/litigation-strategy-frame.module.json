{
  "schema_version": "0.1.0",
  "id": "open-practice/litigation-strategy-frame",
  "title": "诉讼策略选项与责任决策框架",
  "summary": "组织诉讼和和解选项、假设、权衡、信息缺口与不可逆节点，最终选择必须由责任律师和授权客户作出。",
  "module_type": "ARGUMENT_PATTERN",
  "status": "DRAFT",
  "version": "0.1.0",
  "maintainers": ["org:open-practice"],
  "tags": ["litigation", "strategy", "decision-frame"],
  "purpose": {
    "use_when": ["责任律师需要系统整理可选路径、假设、风险和待决定节点"],
    "not_for": ["在客户目标、授权、关键证据或程序姿态缺失时自动选择起诉或和解策略"],
    "completion": ["形成有依据的选项集、权衡、缺口、触发器和明确的责任决定记录"]
  },
  "scope": {
    "jurisdictions": ["UNSPECIFIED"],
    "as_of": "2026-08-31",
    "practice_areas": ["litigation"],
    "lifecycle_stages": ["strategy", "settlement"],
    "limitations": ["高度情境化；本模块只提供协调和决策框架，不输出自动策略结论"],
    "intended_users": ["responsible-lawyer"]
  },
  "interface": {
    "inputs": [
      {"name": "client_objectives", "semantic_type": "matter.objective-set", "data_type": "array", "required": true, "sensitivity": "HIGHLY_CONFIDENTIAL", "description": "经确认的客户目标、风险偏好和授权边界"},
      {"name": "matter_state", "semantic_type": "matter.state", "data_type": "object", "required": true, "sensitivity": "HIGHLY_CONFIDENTIAL", "description": "程序姿态、证据状态、对方行为和时间成本约束"}
    ],
    "outputs": [
      {"name": "option_set", "semantic_type": "analysis.option-set", "data_type": "artifact", "sensitivity": "HIGHLY_CONFIDENTIAL", "description": "策略选项、假设、权衡、缺口和触发条件", "completion": "每个选项都有依据、反对因素、不可逆节点和责任人"},
      {"name": "decision_record", "semantic_type": "matter.decision-record", "data_type": "object", "sensitivity": "HIGHLY_CONFIDENTIAL", "description": "责任律师和授权客户的决定与接受记录", "completion": "责任、授权、时间和保留意见均已明确记录"}
    ],
    "preconditions": ["已完成利益冲突检查，责任律师和授权范围明确"],
    "stop_conditions": ["客户目标、和解授权、关键证据或程序状态不明确"],
    "escalation_conditions": ["涉及不可逆程序行为、证据披露、诉权处分或重大和解授权"]
  },
  "method": {
    "overview": "汇总目标和事项状态，生成选项与反选项，暴露耦合和缺口，交由责任律师与客户决策。",
    "steps": [
      {"id": "confirm-authority", "action": "确认责任、客户目标和授权边界", "responsible_role": "responsible-lawyer", "human_decision": true},
      {"id": "map-options", "action": "形成选项、风险、假设、反例和触发器", "responsible_role": "legal-team", "human_decision": true, "produces": ["option_set"]},
      {"id": "record-decision", "action": "由责任律师和授权客户作出并记录决定", "responsible_role": "responsible-lawyer", "human_decision": true, "produces": ["decision_record"]}
    ],
    "decision_points": ["是否采取不可逆程序行为", "是否在授权范围内提出或接受和解"]
  },
  "dependencies": {
    "modules": [{"id": "open-practice/case-law-research", "version": "0.1.0", "purpose": "提供有范围的裁判研究输入", "optional": true}],
    "sources": [
      {"id": "matter-authorized-sources", "title": "获授权事项来源占位符", "uri": "https://example.invalid/private-matter-sources", "source_type": "INTERNAL", "jurisdiction": "UNSPECIFIED", "accessed_at": "2026-08-31", "rights_basis": "matter-specific-authorization-required"}
    ],
    "tools": []
  },
  "trust": {
    "risk_level": "CRITICAL",
    "required_review": ["RESPONSIBLE_LAWYER", "JURISDICTION_SPECIALIST", "PRIVACY_REVIEWER"],
    "validations": [
      {"level": "L1_SCHEMA", "status": "PASS", "evidence": "local-ajv-validation"},
      {"level": "L5_COUNTEREXAMPLE", "status": "PASS", "evidence": "missing-objectives-and-authority-stops"}
    ],
    "review_claims": []
  },
  "provenance": {
    "contributors": [{"actor": "org:open-practice", "role": "AUTHOR", "contribution": "low-modularizability counterexample"}],
    "derived_from": [],
    "machine_assistance": [{"tool": "Codex", "use": "schema drafting and desk test", "human_reviewed": false}]
  },
  "rights": {
    "content_license": "CC-BY-4.0-proposed",
    "source_specific_rights": ["No private matter content is included in this public research example"],
    "confidentiality_level": "PUBLIC_METHOD_ONLY",
    "contribution_attestation": "research-prototype-no-client-material"
  },
  "state_contract": {
    "reads": ["client_objectives", "matter_state"],
    "writes": ["option_set", "decision_record"],
    "invariants": ["private-matter-data-never-enters-public-release", "final-strategy-requires-explicit-human-decision"],
    "retention": "engagement-and-organization-policy",
    "responsibility_handoff": {"from": "legal-team", "to": "responsible-lawyer", "acceptance": "EXPLICIT"}
  }
}
